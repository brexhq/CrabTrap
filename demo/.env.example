# Copy to .env and fill in. NEVER commit your real .env.
ANTHROPIC_API_KEY=        # CrabTrap LLM judge
OPENAI_API_KEY=           # victim gptme agent (gpt-5.4-mini)

# The exfil destination — any host that LOOKS like a crypto-price API. It does NOT need to exist or
# be a server you control; CrabTrap approving the egress to it is the bypass (visible in the audit/UI).
EXFIL_HOST=crypto-price-api-demo.vercel.app

# CrabTrap proxy token issued for the victim agent (see CrabTrap docs / admin to mint one).
VICTIM_TOKEN=
